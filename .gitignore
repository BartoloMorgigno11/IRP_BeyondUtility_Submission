# Local environments and secrets
.env
.env.*
!.env.example
.venv/
.venv_*/
venv/
env/

# Transitional local archive from cleanup runs; canonical archive files live under
# report/archive/ and results/archive/ when selected for Git.
/archive/

# External evidence bundles remain outside normal Git unless a phase promotes a
# small manifest or report into the tracked foreground.
/archive_external/

# Python cache and tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pytest_cache*/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

